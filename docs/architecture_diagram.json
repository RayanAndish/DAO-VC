{
  "title": "Blockchain DAO for VC - Microservices Architecture",
  "nodes": [
    {"id": "Blockchain_Service", "type": "service", "description": "Manages the private blockchain and consensus algorithm."},
    {"id": "Consensus_Service", "type": "service", "description": "Handles the custom PoA-dPoS-AI consensus protocol."},
    {"id": "Token_Service", "type": "service", "description": "Manages custom tokens and interactions with public blockchains."},
    {"id": "DAO_Service", "type": "service", "description": "Provides DAO management and governance functionalities."},
    {"id": "AI_Analysis_Service", "type": "service", "description": "AI-driven analysis for financial risk and user behavior."},
    {"id": "API_Gateway", "type": "gateway", "description": "Manages external and internal API requests with security controls."},
    {"id": "User_Interface", "type": "frontend", "description": "User interface for interaction with DAO platform."},
    {"id": "Database", "type": "database", "description": "Stores blockchain data, user info, and DAO information securely."}
  ],
  "connections": [
    {"source": "User_Interface", "target": "API_Gateway", "type": "HTTPS"},
    {"source": "API_Gateway", "target": "Blockchain_Service", "type": "gRPC"},
    {"source": "API_Gateway", "target": "Consensus_Service", "type": "gRPC"},
    {"source": "API_Gateway", "target": "Token_Service", "type": "gRPC"},
    {"source": "API_Gateway", "target": "DAO_Service", "type": "REST"},
    {"source": "API_Gateway", "target": "AI_Analysis_Service", "type": "REST"},
    {"source": "Blockchain_Service", "target": "Database", "type": "Encrypted Connection"},
    {"source": "Consensus_Service", "target": "Blockchain_Service", "type": "Internal"},
    {"source": "Token_Service", "target": "Blockchain_Service", "type": "Internal"},
    {"source": "DAO_Service", "target": "Database", "type": "Secure Connection"}
  ]
}